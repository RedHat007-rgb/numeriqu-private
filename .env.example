# --- GLOBAL WORKSPACE ENVIRONMENT VARIABLES ---

# 0. Supabase Auth (required by both apps)
# API (backend): uses service role key for JWT validation + admin user creation
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_KEY="[YOUR_SUPABASE_ANON_OR_SERVICE_KEY]"          # used by SupabaseAuthGuard (getUser)
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"          # used by OtpService (admin.createUser)
# Web (frontend): uses anon key — safe to expose
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"
# Backend API URL reachable by the Next.js frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Resend (OTP email delivery)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"  # must be a verified domain on Resend

# 1. Database Configuration (Prisma)
# Supabase acts as our Postgres database, providing the user context via auth
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# 2. ClickHouse Configuration (Data Warehouse)
# Target cluster for dual-ingestion analytical query loads
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_QUICKBOOKS_URL="http://localhost:8123"
CLICKHOUSE_QUICKBOOKS_USER="quickbooks"
CLICKHOUSE_QUICKBOOKS_PASSWORD=""

# 3. QuickBooks Integration (Custom Ingestion Pipeline)
# Credentials directly used by the `@nestjs` node-quickbooks worker 
QB_CLIENT_ID="your-quickbooks-client-id"
QB_CLIENT_SECRET="your-quickbooks-client-secret"
QB_ENVIRONMENT="sandbox" # either 'sandbox' or 'production'

# 4. Airbyte Server API (Xero and Supported Pipelines)
# Used to dynamically invoke Airbyte Workspaces 
AIRBYTE_API_URL="http://localhost:8000/api/v1"
AIRBYTE_WORKSPACE_ID="your-airbyte-workspace-id"

# 5. Xero OAuth Application config
# The API credentials from developer.xero.com to execute User authorization.
XERO_CLIENT_ID="[YOUR_XERO_CLIENT_ID]"
XERO_CLIENT_SECRET="[YOUR_XERO_CLIENT_SECRET]"
XERO_REDIRECT_URI="http://localhost:3000/auth/xero/callback"
