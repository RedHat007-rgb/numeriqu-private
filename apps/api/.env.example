# Prisma/TypeORM Database connection
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# ClickHouse Configuration
# Target url for ClickHouse queries & custom ingestion inserts
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# Supabase Auth & Observability State Tracking
# Used to authenticate backend requests against Supabase and track Sync Jobs
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6... [YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6... [YOUR_SERVICE_ROLE_KEY]"
SUPABASE_INTERNAL_AUTH_SECRET="replace-with-long-random-secret"

# OTP delivery
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Numeriqu <noreply@yourdomain.com>"
REDIS_URL="redis://localhost:6379"

# QuickBooks Application Credentials 
# Used by node-quickbooks for custom native ingestion pipeline
QB_CLIENT_ID="your-quickbooks-client-id"
QB_CLIENT_SECRET="your-quickbooks-client-secret"
