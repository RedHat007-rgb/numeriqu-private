# Prisma/TypeORM Database connection
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# ClickHouse Configuration
# Target url for ClickHouse queries & custom ingestion inserts
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# Per-provider ClickHouse database names — MUST match the databases your CH users have access to.
# Missing these causes ingestion to fall back to 'default' while the transform reads 'xero_custom',
# so raw data lands in the wrong DB and nothing reaches the gold layer.
CLICKHOUSE_XERO_DB="xero_custom"
CLICKHOUSE_XERO_URL="http://localhost:8123"
CLICKHOUSE_XERO_USER="xero_app_user"
CLICKHOUSE_XERO_PASSWORD=""
CLICKHOUSE_QUICKBOOKS_DB="quickbooks"
CLICKHOUSE_QUICKBOOKS_URL="http://localhost:8123"
CLICKHOUSE_QUICKBOOKS_USER="quickbooks"
CLICKHOUSE_QUICKBOOKS_PASSWORD=""
CLICKHOUSE_ANALYTICS_DB="analytics"
CLICKHOUSE_ANALYTICS_URL="http://localhost:8123"
CLICKHOUSE_ANALYTICS_USER="dbt_transformer"
CLICKHOUSE_ANALYTICS_PASSWORD=""

# Supabase Auth & Observability State Tracking
# Used to authenticate backend requests against Supabase and track Sync Jobs
SUPABASE_URL="https://[YOUR_PROJECT_ID].supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6... [YOUR_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6... [YOUR_SERVICE_ROLE_KEY]"
SUPABASE_INTERNAL_AUTH_SECRET="replace-with-long-random-secret"

# OTP delivery
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Numeriqu <noreply@yourdomain.com>"
REDIS_URL="redis://localhost:6379"

# QuickBooks Application Credentials 
# Used by node-quickbooks for custom native ingestion pipeline
QB_CLIENT_ID="your-quickbooks-client-id"
QB_CLIENT_SECRET="your-quickbooks-client-secret"
