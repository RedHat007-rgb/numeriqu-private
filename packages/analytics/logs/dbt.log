  as (
    WITH raw_source AS (
    SELECT *
    FROM `xero_custom`.`xero_raw`
    WHERE resource = 'Invoices'
)

SELECT
    -- Metadata
    tenant_id,
    user_id,
    connection_id,
    'xero' AS provider,
    
    -- Core Identity
    source_id AS invoice_external_id,
    JSONExtractString(raw_data, 'invoiceNumber') AS invoice_number,
    
    -- Financials
