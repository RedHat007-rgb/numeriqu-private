    JSONExtractString(raw_data, 'CurrencyRef', 'value') AS currency,
    
    -- Status
    JSONExtractBool(raw_data, 'Active') AS is_active,
    
    -- Audit
    updated_at,
    synced_at

FROM raw_source
    
  )
      
      
