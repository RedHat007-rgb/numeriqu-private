    WHERE resource = 'Account'
)

SELECT
    -- Metadata
    tenant_id,
    user_id,
    connection_id,
    'quickbooks' AS provider,
    
    -- Core Identity
    source_id AS account_external_id,
    JSONExtractString(raw_data, 'Name') AS account_name,
