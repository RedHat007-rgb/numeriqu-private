    parseDateTimeBestEffort(JSONExtractString(raw_data, 'dueDate')) AS due_at,
    
    -- Status
    JSONExtractString(raw_data, 'status') AS status,
    
    -- Audit
    updated_at,
    synced_at

FROM raw_source
    
  )
      
      
