    '' AS invoice_type,

    -- Client / contact
    JSONExtractString(raw_data, 'CustomerRef', 'value') AS contact_id,
    JSONExtractString(raw_data, 'CustomerRef', 'name') AS contact_name,
    
    -- Audit
    updated_at,
    synced_at

FROM raw_source
    
