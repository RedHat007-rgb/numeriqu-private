    -- Dates
    parseDateTimeBestEffort(JSONExtractString(raw_data, 'TxnDate')) AS issued_at,
    parseDateTimeBestEffort(JSONExtractString(raw_data, 'DueDate')) AS due_at,
    
    -- Status
    JSONExtractString(raw_data, 'EmailStatus') AS status,
    
    -- Audit
    updated_at,
    synced_at

FROM raw_source
    
  )
      
      
