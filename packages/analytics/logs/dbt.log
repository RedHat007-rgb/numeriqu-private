  create or replace view `analytics`.`stg_xero_accounts` 
  
    
  
  
    
    
  as (
    WITH raw_source AS (
    SELECT *
    FROM `accounting_raw`.`xero_raw`
    WHERE resource = 'Accounts'
)

SELECT
    -- Metadata
    tenant_id,
    user_id,
    connection_id,
    'xero' AS provider,
    
    -- Core Identity
    source_id AS account_external_id,
    JSONExtractString(raw_data, 'Name') AS account_name,
    JSONExtractString(raw_data, 'Type') AS account_type,
    JSONExtractString(raw_data, 'Class') AS account_sub_type,
    
    -- Classification
    CASE 
        WHEN JSONExtractString(raw_data, 'Class') IN ('ASSET', 'LIABILITY', 'EQUITY') THEN 'BalanceSheet'
        ELSE 'ProfitAndLoss'
    END AS classification,
    JSONExtractString(raw_data, 'CurrencyCode') AS currency,
    
    -- Status
    CASE WHEN JSONExtractString(raw_data, 'Status') = 'ACTIVE' THEN true ELSE false END AS is_active,
    
    -- Audit
    updated_at,
    synced_at

FROM raw_source
    
  )
      
      
