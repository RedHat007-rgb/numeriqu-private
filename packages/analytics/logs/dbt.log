)

SELECT
    -- Metadata
    tenant_id,
    user_id,
    connection_id,
    'quickbooks' AS provider,
    
    -- Core Identity
    source_id AS invoice_external_id,
    JSONExtractString(raw_data, 'DocNumber') AS invoice_number,
    
    -- Financials
    JSONExtractFloat(raw_data, 'TotalAmt') AS total_amount,
