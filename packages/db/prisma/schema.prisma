  agentSession       AgentChatSession? @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  generatedDashboard Dashboard?        @relation("GeneratedDashboard", fields: [generatedDashboardId], references: [id], onDelete: SetNull)
