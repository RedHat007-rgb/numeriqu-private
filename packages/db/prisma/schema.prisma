model Signal {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  sourceKey          String    @unique @map("source_key")
  signalMetricId     String    @map("signal_metric_id") @db.Uuid
  signalType         String    @map("signal_type")
  severity           String
  status             String    @default("NEW")
  title              String
  summary            String
  impactAmount       Decimal   @default(0) @map("impact_amount") @db.Decimal(18, 2)
  confidenceScore    Decimal   @default(0) @map("confidence_score") @db.Decimal(6, 4)
  entityScope        Json      @map("entity_scope")
  timeWindow         Json      @map("time_window")
  comparisonWindow   Json      @map("comparison_window")
  assignedToUserId   String?   @map("assigned_to_user_id") @db.Uuid
  acknowledgedAt     DateTime? @map("acknowledged_at")
  dismissedAt        DateTime? @map("dismissed_at")
  dismissedReason    String?   @map("dismissed_reason")
  evidenceComputedAt DateTime? @map("evidence_computed_at")
  lastRefreshedAt    DateTime? @map("last_refreshed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signalMetric   SignalMetric      @relation(fields: [signalMetricId], references: [id], onDelete: Cascade)
  assignedToUser User?             @relation("SignalAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  evidence       SignalEvidence[]
  comments       SignalComment[]
  boardPacks     SignalBoardPack[]

  @@index([organizationId, status, severity, createdAt])
  @@index([organizationId, signalMetricId, createdAt])
  @@index([organizationId, assignedToUserId])
  @@map("signals")
}

model SignalEvidence {
